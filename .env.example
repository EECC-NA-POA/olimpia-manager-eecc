# Copie para .env e preencha. NUNCA commite o .env (ele fica fora do versionamento).
# Estas duas sao chaves publicas de cliente (seguras no bundle); o controle de acesso e a RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ATENCAO: segredos de servidor (SUPABASE_SERVICE_ROLE_KEY, FIREBASE_SERVICE_ACCOUNT / private key)
# NAO devem ficar no .env deste projeto nem em nenhum arquivo versionado.
# Guarde-os em cofre de segredos ou nas variaveis de ambiente do host/CI.
